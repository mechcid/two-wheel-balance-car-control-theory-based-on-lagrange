<sdf version='1.11'>
  <model name='balance'>
    <link name='base_link'>
      <inertial>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <mass>2</mass>
        <inertia>
          <ixx>0.10000000000000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.080000000000000002</iyy>
          <iyz>0</iyz>
          <izz>0.059999999999999998</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <geometry>
          <box>
            <size>0.23999999999999999 0.28000000000000003 0.35999999999999999</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0.29999999999999999 0 0 0</pose>
        <geometry>
          <box>
            <size>0.23999999999999999 0.28000000000000003 0.35999999999999999</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.125 0.37500003 1 1</diffuse>
          <ambient>0.125 0.37500003 1 1</ambient>
        </material>
      </visual>
      <sensor name='imu' type='imu'>
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <topic>/balance/imu</topic>
        <imu>
          <orientation_reference_frame>
            <localization>CUSTOM</localization>
            <custom_rpy parent_frame='world'>0 0 0</custom_rpy>
          </orientation_reference_frame>
        </imu>
      </sensor>
    </link>
    <joint name='left_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0 0.20000000000000001 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>5</effort>
          <velocity>100</velocity>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='left_wheel'>
      <pose relative_to='left_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0025000000000000001</iyy>
          <iyz>0</iyz>
          <izz>0.00125</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.10000000000000001</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='left_wheel_visual'>
        <pose>0 0 0 1.5707963267948959 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.025000000000000001</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.125 0.125 0.125 1</diffuse>
          <ambient>0.125 0.125 0.125 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='right_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0 -0.20000000000000001 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>5</effort>
          <velocity>100</velocity>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='right_wheel'>
      <pose relative_to='right_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0025000000000000001</iyy>
          <iyz>0</iyz>
          <izz>0.00125</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.10000000000000001</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='right_wheel_visual'>
        <pose>0 0 0 1.5707963267948959 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.025000000000000001</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.125 0.125 0.125 1</diffuse>
          <ambient>0.125 0.125 0.125 1</ambient>
        </material>
      </visual>
    </link>
    <plugin name='gz_ros2_control::GazeboSimROS2ControlPlugin' filename='libgz_ros2_control-system.so'>
      <parameters>/home/mechcid/lagarain/ros2_ws/install/balance_sim/share/balance_sim/config/controllers.yaml</parameters>
    </plugin>
    <plugin name='gz::sim::systems::OdometryPublisher' filename='gz-sim-odometry-publisher-system'>
      <dimensions>3</dimensions>
