```xml
<?xml version="1.0"?>

<sdf version="1.9">

    <world name="balance_world">

        <!-- ===================================================== -->
        <!-- 重力                                                  -->
        <!-- ===================================================== -->

        <gravity>
            0 0 -9.81
        </gravity>


        <!-- ===================================================== -->
        <!-- 物理仿真参数                                          -->
        <!-- ===================================================== -->

        <physics
            name="physics"
            type="ignored">

            <max_step_size>0.001</max_step_size>
            <real_time_factor>0.5</real_time_factor>

        </physics>


        <!-- ===================================================== -->
        <!-- Gazebo 系统插件                                       -->
        <!-- ===================================================== -->

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

        <plugin
            filename="gz-sim-apply-link-wrench-system"
            name="gz::sim::systems::ApplyLinkWrench"/>


        <!-- ===================================================== -->
        <!-- 光源                                                  -->
        <!-- ===================================================== -->

        <light
            name="sun"
            type="directional">

            <pose>
                0 0 10 0 0 0
            </pose>

            <diffuse>
                0.8 0.8 0.8 1
            </diffuse>

            <direction>
                -0.5 0.1 -0.9
            </direction>

        </light>


        <!-- ===================================================== -->
        <!-- 地面模型                                              -->
        <!-- ===================================================== -->

        <model name="ground">

            <static>true</static>

            <link name="ground_link">

                <!-- 碰撞模型 -->
                <collision name="collision">

                    <geometry>

                        <plane>

                            <normal>
                                0 0 1
                            </normal>

                            <size>
                                100 100
                            </size>

                        </plane>

                    </geometry>

                    <!-- 接触面参数 -->
                    <surface>

                        <friction>

                            <ode>
                                <mu>1</mu>
                                <mu2>1</mu2>
                            </ode>

                        </friction>

                    </surface>

                </collision>


                <!-- 可视模型 -->
                <visual name="visual">

                    <geometry>

                        <plane>

                            <normal>
                                0 0 1
                            </normal>

                            <size>
                                100 100
                            </size>

                        </plane>

                    </geometry>

                </visual>

            </link>

        </model>

    </world>

</sdf>
```